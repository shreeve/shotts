# Inline lucide icons (https://lucide.dev/icons/), all on a 24-point grid with a 2-point stroke.

export type IconName =
  | 'arrow-right' | 'arrow-tool' | 'callout' | 'check' | 'circle' | 'clipboard' | 'copy'
  | 'crop' | 'crosshair' | 'download' | 'github' | 'heart' | 'highlighter' | 'history'
  | 'keyboard' | 'line' | 'lock' | 'mic' | 'monitor' | 'moon' | 'pen' | 'pipette'
  | 'pixelate' | 'pointer' | 'scroll' | 'shield' | 'square' | 'sun' | 'terminal' | 'text'
  | 'video' | 'window'

export Icon = component extends svg
  @name: IconName
  @strokeWidth?: number := 2
  render
    svg
      viewBox: '0 0 24 24'
      fill: 'none'
      stroke: 'currentColor'
      stroke-width: strokeWidth
      stroke-linecap: 'round'
      stroke-linejoin: 'round'
      aria-hidden: 'true'
      switch name
        when 'arrow-right'
          path d: 'M5 12h14'
          path d: 'm12 5 7 7-7 7'
        when 'arrow-tool'
          path d: 'M7 17 17 7'
          path d: 'M7 7h10v10'
        when 'callout'
          path d: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'
          path d: 'M13 8H7'
          path d: 'M17 12H7'
        when 'check'
          path d: 'M20 6 9 17l-5-5'
        when 'circle'
          circle cx: 12, cy: 12, r: 9
        when 'clipboard'
          rect x: 8, y: 2, width: 8, height: 4, rx: 1
          path d: 'M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2'
          path d: 'm9 14 2 2 4-4'
        when 'copy'
          rect x: 8, y: 8, width: 14, height: 14, rx: 2
          path d: 'M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2'
        when 'crop'
          path d: 'M6 2v14a2 2 0 0 0 2 2h14'
          path d: 'M18 22V8a2 2 0 0 0-2-2H2'
        when 'crosshair'
          circle cx: 12, cy: 12, r: 10
          path d: 'M22 12h-4'
          path d: 'M6 12H2'
          path d: 'M12 6V2'
          path d: 'M12 22v-4'
        when 'download'
          path d: 'M12 15V3'
          path d: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'
          path d: 'm7 10 5 5 5-5'
        when 'github'
          path d: 'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4'
          path d: 'M9 18c-4.51 2-5-2-7-2'
        when 'heart'
          path d: 'M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z'
        when 'highlighter'
          path d: 'm9 11-6 6v3h9l3-3'
          path d: 'm22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4'
        when 'history'
          path d: 'M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8'
          path d: 'M3 3v5h5'
        when 'keyboard'
          rect x: 2, y: 4, width: 20, height: 16, rx: 2
          path d: 'M6 8h.01'
          path d: 'M10 8h.01'
          path d: 'M14 8h.01'
          path d: 'M18 8h.01'
          path d: 'M8 12h.01'
          path d: 'M12 12h.01'
          path d: 'M16 12h.01'
          path d: 'M7 16h10'
        when 'line'
          path d: 'M5 19 19 5'
        when 'lock'
          rect x: 3, y: 11, width: 18, height: 11, rx: 2
          path d: 'M7 11V7a5 5 0 0 1 10 0v4'
        when 'mic'
          path d: 'M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z'
          path d: 'M19 10v2a7 7 0 0 1-14 0v-2'
          path d: 'M12 19v3'
        when 'monitor'
          rect x: 2, y: 3, width: 20, height: 14, rx: 2
          path d: 'M8 21h8'
          path d: 'M12 17v4'
        when 'moon'
          path d: 'M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'
        when 'pen'
          path d: 'M12 20h9'
          path d: 'M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z'
        when 'pipette'
          path d: 'm2 22 1-1h3l9-9'
          path d: 'M3 21v-3l9-9'
          path d: 'm15 6 3.4-3.4a2.1 2.1 0 1 1 3 3L18 9l.4.4a2.1 2.1 0 1 1-3 3l-3.8-3.8a2.1 2.1 0 1 1 3-3l.4.4Z'
        when 'pixelate'
          rect x: 3, y: 3, width: 18, height: 18, rx: 2
          path d: 'M3 9h18'
          path d: 'M3 15h18'
          path d: 'M9 3v18'
          path d: 'M15 3v18'
        when 'pointer'
          path d: 'M14 4.1 12 6'
          path d: 'm5.1 8-2.9-.8'
          path d: 'm6 12-1.9 2'
          path d: 'M7.2 2.2 8 5.1'
          path d: 'M9.037 9.69a.498.498 0 0 1 .653-.653l11 4.5a.5.5 0 0 1-.074.949l-4.349 1.041a1 1 0 0 0-.74.739l-1.04 4.35a.5.5 0 0 1-.95.074z'
        when 'scroll'
          path d: 'm7 6 5 5 5-5'
          path d: 'm7 13 5 5 5-5'
        when 'shield'
          path d: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z'
          path d: 'm9 12 2 2 4-4'
        when 'square'
          rect x: 3, y: 3, width: 18, height: 18, rx: 2
        when 'sun'
          circle cx: 12, cy: 12, r: 4
          path d: 'M12 2v2'
          path d: 'M12 20v2'
          path d: 'm4.93 4.93 1.41 1.41'
          path d: 'm17.66 17.66 1.41 1.41'
          path d: 'M2 12h2'
          path d: 'M20 12h2'
          path d: 'm6.34 17.66-1.41 1.41'
          path d: 'm19.07 4.93-1.41 1.41'
        when 'terminal'
          path d: 'm4 17 6-6-6-6'
          path d: 'M12 19h8'
        when 'text'
          path d: 'M4 7V4h16v3'
          path d: 'M9 20h6'
          path d: 'M12 4v16'
        when 'video'
          path d: 'm16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5'
          rect x: 2, y: 6, width: 14, height: 12, rx: 2
        when 'window'
          rect x: 2, y: 4, width: 20, height: 16, rx: 2
          path d: 'M2 8h20'
          path d: 'M6 4v4'
          path d: 'M10 4v4'
